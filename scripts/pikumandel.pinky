leftEdge    := -520
rightEdge   := 300
topEdge     := 300
bottomEdge  := -300
xStep       := 3
yStep       := 7

maxIter     := 300

y0 := bottomEdge
while y0 < topEdge do
    x0 := leftEdge
    while x0 < rightEdge do
        x := 0
        y := 0
        i := 0
        theChar := " "
        while i < maxIter do
            x_x := (x * x) / 200
            y_y := (y * y) / 200
            if x_x + y_y > 800 then
                theChar := "" + i
                if i > 9 then 
                    theChar := "@"
                end
                i := maxIter
            end
            y := x * y / 100 + y0
            x := x_x - y_y + x0
            i := i + 1
        end
        print(theChar)
        x0 := x0 + xStep
    end
    println ""
    y0 := y0 + yStep
end
